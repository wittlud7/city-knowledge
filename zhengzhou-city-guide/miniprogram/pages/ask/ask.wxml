<view class="page"><view class="row between"><view class="eyebrow">ASK ZHENGZHOU</view><button class="link" bindtap="history">问答记录</button></view><view class="h1">从一个问题开始</view><view class="sub">{{mode}} · 回答附来源</view><view wx:if="{{showHistory}}" class="panel"><view wx:for="{{history}}" wx:key="id" class="article-row" data-id="{{item.id}}" bindtap="restore">{{item.question}}</view><view wx:if="{{!history.length}}" class="muted">还没有记录</view></view><view wx:if="{{!messages.length}}" class="panel"><view class="h2">你的郑州，你来提问。</view><view class="sub">告诉我你的位置、时间与需要，或从下面的问题开始。</view><button wx:for="{{prompts}}" wx:key="*this" class="link" data-text="{{item}}" bindtap="prompt">{{item}} ↗</button></view><view wx:for="{{messages}}" wx:key="id" wx:for-item="message"><view class="chat-question">{{message.question}}</view><view class="chat-card"><view class="eyebrow">{{message.mode==='ai'?'AI综合回答':'资料检索回答'}}</view><view class="body" selectable>{{message.answer}}</view><view wx:if="{{message.warning}}" class="notice">{{message.warning}}</view><view wx:for="{{message.citations}}" wx:key="id" wx:for-item="citation" class="citation"><view data-id="{{citation.articleId}}" bindtap="article">[{{citation.id}}] {{citation.title}} ↗</view><view class="meta" data-source="{{citation.source}}" bindtap="source">{{citation.source.publisher}} · 复制官方链接</view></view><view class="row"><button class="link" data-id="{{message.id}}" data-type="helpful" bindtap="rate">有帮助</button><button class="link" data-id="{{message.id}}" data-type="unhelpful" bindtap="rate">需要改进</button></view></view></view><view wx:if="{{busy}}" class="notice">正在查找相关资料…</view><view class="chat-compose"><textarea placeholder="想了解郑州的什么？可补充地点、时间与需求" value="{{question}}" bindinput="input" maxlength="1500"/><button class="primary" loading="{{busy}}" disabled="{{busy||!question}}" bindtap="submit">发送问题 →</button></view><view class="notice">未配置大模型时为资料检索。实时状态与个人资格请通过官方渠道核实，请勿输入敏感个人信息。</view></view>
