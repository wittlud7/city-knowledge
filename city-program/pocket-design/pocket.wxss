/* 原生小程序：一套字体、一种主要颜色、清楚的生活语言。 */
page{background:#f8f9f5;color:#25372c;font-family:CityUISans,-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6}
.h1,.h2,.title,.hero .h1,.real-hero .h1,.scenario-native .title{font-family:inherit;color:#25372c;letter-spacing:0}
.h1{font-size:52rpx;line-height:1.4;font-weight:600}.h2{font-size:36rpx;line-height:1.5;font-weight:600;border:0;padding-left:0}.title{font-size:30rpx;font-weight:600}.body{font-size:28rpx;color:#505d54;line-height:1.9}.sub{font-size:27rpx;color:#68726c}.eyebrow{font-size:22rpx;letter-spacing:0;color:#77837a}
.primary{background:#477a56;border:0;border-bottom:6rpx solid #345d40;color:white;border-radius:23rpx;box-shadow:none;transform:none}.secondary{background:white;color:#477a56;border:2rpx solid #dce5db;box-shadow:none;transform:none}.panel,.card,.chat-card{background:white;border:2rpx solid #e7ebe4;border-radius:22rpx;box-shadow:none;transform:none}.link{color:#477a56}.meta,.muted{font-size:24rpx;color:#818a83}.source{background:#eef4e9;border:0;border-radius:18rpx}.source .title{font-size:27rpx}.scope-note{background:#f3f5ea;color:#788361;border-left:4rpx solid #b3c495}.notice{font-size:24rpx;line-height:1.8;color:#7e877e;background:#f1f4ec;border:0;padding:22rpx;border-radius:16rpx}.field,textarea{font-family:inherit;background:white;border:2rpx solid #e0e7dc;color:#25372c;border-radius:16rpx}.tag,.chip{background:#eff3e9;color:#64765c}.chip.active,.tabs button.active{background:#e6f0df;color:#477a56;border-color:#c6d8bd}.chat-question{background:#e9f1e3;border:0;color:#374f3b}.footer{color:#8f988e;font-size:22rpx}
.pocket-home{padding:38rpx 38rpx 42rpx;background:#f8f9f5;font-family:inherit;color:#25372c;box-sizing:border-box}
.pocket-home button{font-family:inherit;margin:0;line-height:inherit;border:0;border-radius:0;box-shadow:none;background:transparent;color:inherit;font-weight:400;transform:none;text-align:left;display:block;padding:0;min-height:0}.pocket-home button::after{border:0}.pocket-home image{display:block;flex-shrink:0}
.pocket-top{display:flex;align-items:center;justify-content:space-between;height:47rpx}.pocket-location{display:flex;align-items:center;gap:12rpx;font-size:32rpx;font-weight:600}.pocket-location image{width:33rpx;height:38rpx;object-fit:contain}
.pocket-home .pocket-text-button{display:flex;align-items:center;justify-content:center;gap:6rpx;font-size:25rpx;line-height:1.6;color:#6c776e;white-space:nowrap;padding:6rpx 0}.pocket-text-button image{width:24rpx;height:24rpx;opacity:.8}
.pocket-intro{margin-top:43rpx}.pocket-heading{font-size:54rpx;font-weight:650;line-height:1.32;letter-spacing:-.3rpx;color:#25372c}.pocket-subtitle{font-size:28rpx;line-height:1.65;color:#747e77;margin-top:15rpx}
.pocket-question{margin-top:34rpx;background:#eaf1e5;border-radius:29rpx;padding:27rpx 29rpx 24rpx}.pocket-question-title{font-size:34rpx;line-height:1.5;font-weight:600;color:#25372c}
.pocket-input{display:flex;align-items:center;gap:15rpx;background:white;border-radius:22rpx;height:88rpx;padding:0 24rpx;margin-top:22rpx;box-sizing:border-box}.pocket-input>image{height:35rpx;width:35rpx}.pocket-input input{font-family:inherit;font-size:29rpx;color:#25372c;flex:1;min-width:0;height:66rpx;line-height:1.5;background:transparent;border:0;padding:0}
.pocket-home .pocket-primary{display:flex;align-items:center;justify-content:center;height:91rpx;box-sizing:border-box;background:#477a56;color:white;border-radius:22rpx;border:0;border-bottom:7rpx solid #345d40;text-align:center;font-size:30rpx;font-weight:600;margin-top:18rpx;line-height:1.3}.pocket-home .pocket-primary:active{transform:translateY(4rpx);border-bottom-width:3rpx}.pocket-primary[disabled]{opacity:.6}.pocket-question-note{font-size:23rpx;color:#75816e;line-height:1.6;text-align:center;margin-top:17rpx}
.pocket-domains{display:grid;grid-template-columns:repeat(3,1fr);gap:21rpx 15rpx;padding:34rpx 1rpx 35rpx;border-bottom:2rpx solid #e6ebe1}.pocket-home .pocket-domain{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:11rpx;font-size:26rpx;line-height:1.4;color:#334337;text-align:center;padding:0;min-height:133rpx}.pocket-domain-icon{width:103rpx;height:103rpx;border-radius:50%;background:#edf3e7;display:flex;align-items:center;justify-content:center}.pocket-domain-icon image{width:54rpx;height:54rpx}.pocket-domain:active .pocket-domain-icon{background:#deead5;transform:translateY(2rpx)}
.pocket-section-top{display:flex;align-items:center;justify-content:space-between;gap:15rpx;margin-top:29rpx;margin-bottom:11rpx}.pocket-section-heading{font-size:34rpx;line-height:1.5;font-weight:600;color:#25372c}.pocket-section-top .pocket-text-button{font-size:24rpx;color:#477a56}
.pocket-home .pocket-guide{display:flex;align-items:center;justify-content:space-between;gap:13rpx;padding:19rpx 0 18rpx;border-bottom:2rpx solid #e4e9df;width:100%}.pocket-guide-copy{flex:1;min-width:0}.pocket-guide-title{font-size:28rpx;line-height:1.55;font-weight:550;color:#2c3c30}.pocket-guide-meta{font-size:23rpx;line-height:1.55;color:#8a9389;margin-top:2rpx}.pocket-guide>image{width:26rpx;height:26rpx;opacity:.85}
.pocket-home .pocket-coverage{font-size:22rpx;line-height:1.6;color:#929a8f;padding-top:11rpx;padding-bottom:5rpx}.pocket-state,.pocket-error{padding:30rpx 0;color:#7b8877;font-size:26rpx}.pocket-error{color:#966c4b}.pocket-error .pocket-text-button{justify-content:flex-start;color:#477a56}
.pocket-photo-section{margin-top:35rpx;border-top:2rpx solid #e6ebe1}.pocket-city-photo{width:100%;height:290rpx;border-radius:17rpx;margin-top:16rpx}.pocket-photo-meta{font-size:22rpx;line-height:1.7;color:#939b8e;margin-top:12rpx}.pocket-photo-section>.pocket-text-button{justify-content:flex-start;font-size:23rpx;color:#477a56}.pocket-bottom-note{font-size:24rpx;color:#73826c;margin-top:35rpx;line-height:1.8}.pocket-bottom-note>view{font-size:21rpx;color:#9ba393;margin-top:3rpx}
.pocket-home .pocket-primary{width:100%}
.pocket-question{margin-top:31rpx;padding-top:24rpx;padding-bottom:21rpx}
.pocket-domains{padding-top:30rpx;padding-bottom:27rpx;row-gap:17rpx}
.pocket-home .pocket-domain{row-gap:9rpx}
.pocket-home .pocket-guide{padding-top:16rpx;padding-bottom:15rpx}
.pocket-heading{font-weight:700}.pocket-question-title,.pocket-section-heading{font-weight:650}.pocket-guide-title{font-weight:600}
.pocket-home .pocket-guide{padding-top:12rpx;padding-bottom:11rpx}
.pocket-guide-meta{line-height:1.3}.pocket-home .pocket-coverage{padding-top:0;font-size:20rpx;line-height:1.25}
