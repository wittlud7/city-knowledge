<view class="page"><view class="eyebrow">SETTLE INTO XI'AN</view><view class="h1">生活的事，一件件来</view><view class="sub">建立自己的清单，更改会自动保存。</view><view class="panel"><view class="tabs"><button wx:for="{{boot.checklists}}" wx:key="id" class="{{selected===item.id?'active':''}}" data-id="{{item.id}}" bindtap="tab">{{item.audience}}</button></view><view class="h2">{{template.title}}</view><view class="meta">已完成 {{done}} / {{items.length}} 项</view><view wx:for="{{items}}" wx:key="index" class="row between"><view class="check-row {{item.done?'checked':''}}" style="flex:1" data-index="{{index}}" bindtap="toggle"><view class="check-box">{{item.done?'✓':''}}</view><view>{{item.text}}</view></view><button class="small-button" data-index="{{index}}" bindtap="remove">×</button></view><view class="search"><input placeholder="添加自己的事项…" value="{{custom}}" bindinput="input" maxlength="200"/><button disabled="{{!custom}}" bindtap="add">＋</button></view></view><view class="h2">可靠的生活信息入口</view><view wx:for="{{articles}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="article"><view class="title">{{item.title}} ↗</view><view class="body">{{item.body}}</view></view></view>
