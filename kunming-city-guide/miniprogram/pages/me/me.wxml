<view class="page"><view class="eyebrow">MY KUNMING</view><view class="h1">留下喜欢的昆明</view><view class="sub">游客记录保存在当前访问身份下，不自动跨设备同步。</view><view class="panel profile"><view class="label">昵称</view><input class="field" value="{{name}}" data-field="name" bindinput="input" maxlength="40"/><view class="label">关注区域</view><input class="field" value="{{district}}" placeholder="例如：所在区县" data-field="district" bindinput="input" maxlength="20"/><button class="secondary" bindtap="profile">保存偏好</button><button wx:if="{{health.wechat}}" class="link" bindtap="login">切换为微信身份</button></view><view class="grid"><button class="secondary" data-page="plan" bindtap="go">行程规划</button><button class="secondary" data-page="life" bindtap="go">生活清单</button><button class="secondary" data-page="events" bindtap="go">展览活动</button><button class="secondary" data-page="sources" bindtap="go">资料来源</button></view><view class="tabs"><button class="{{tab==='favorite'?'active':''}}" data-tab="favorite" bindtap="tab">收藏</button><button class="{{tab==='plan'?'active':''}}" data-tab="plan" bindtap="tab">行程计划</button><button class="{{tab==='chat'?'active':''}}" data-tab="chat" bindtap="tab">问答记录</button></view><view wx:for="{{filtered}}" wx:key="id" class="panel"><view class="row between"><view class="title" data-id="{{item.id}}" bindtap="open">{{item.title||item.question}} {{tab==='favorite'?'↗':''}}</view><button class="small-button" data-id="{{item.id}}" bindtap="remove">删除</button></view><view wx:if="{{tab==='chat'}}" class="body">{{item.answer}}</view><block wx:if="{{tab==='plan'}}"><view wx:for="{{item.days}}" wx:key="day" wx:for-item="day"><view class="label">第 {{day.day}} 天</view><view wx:for="{{day.stops}}" wx:key="id" wx:for-item="stop" class="body">{{index+1}}. {{stop.name}}</view></view><view class="notice">{{item.budget.note}}</view></block></view><view wx:if="{{!filtered.length}}" class="empty">还没有记录，探索之后再回来看看。</view><button class="secondary" bindtap="export">导出我的资料</button><button class="link" data-page="admin" bindtap="go">内容管理入口 →</button><view class="footer">独立建设 · 非官方产品</view></view>
