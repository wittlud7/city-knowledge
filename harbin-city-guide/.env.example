PORT=8807
HOST=127.0.0.1
# Opt in only after reviewing source access rules. Due sources are checked every 6h.
ENABLE_SOURCE_MONITOR=false
# Required before exposing the server outside localhost. Never place this in client code.
ADMIN_PASSWORD=
# Optional: OpenAI-compatible chat completion endpoint (server only).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Optional WeChat identity exchange, both values required for real login.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Optional CORS origin for a separately hosted web client.
WEB_ORIGIN=
