.walk-page .field-title { margin-bottom:14rpx; }
.walk-stage {
  position:relative;
  height:415rpx;
  margin-top:24rpx;
  background:#eae7d9;
  background:linear-gradient(170deg,#ebeade,#dbe3d5);
  border:1px solid #afbcae;
  overflow:hidden;
}
.walk-art { position:absolute; inset:0; perspective:750rpx; pointer-events:none; }
.walk-board {
  position:absolute;
  top:17%;
  left:9%;
  width:82%;
  height:68%;
  background:#c1cdb0;
  border:4rpx solid #f5eed9;
  box-shadow:0 10rpx 0 #82977e,0 22rpx 22rpx #47635050;
  transform:rotateX(52deg) rotateZ(-20deg);
  transform-style:preserve-3d;
  transition:transform 360ms ease;
}
.walk-alt .walk-board { transform:rotateX(51deg) rotateZ(16deg); }
.walk-road { position:absolute; left:47%; top:0; width:12%; height:100%; background:#ead7b2; }
.walk-road::after { content:""; position:absolute; left:50%; top:0; bottom:0; border-left:2rpx dashed #faf1da; }
.walk-plaza { position:absolute; inset:15% 5% 10% 64%; border:2rpx solid #91a386; background:#ccd8b9; }
.walk-model { position:absolute; transform-style:preserve-3d; width:125rpx; height:85rpx; }
.walk-model--museum { left:12%; top:34%; color:#799597; }
.walk-model--taoxichuan { left:68%; top:33%; color:#a25f4c; }
.walk-volume { position:absolute; inset:0; transform-style:preserve-3d; transition:transform 230ms ease; }
.walk-model-active .walk-volume { transform:translateZ(16rpx); }
.walk-face { position:absolute; box-sizing:border-box; }
.walk-roof { inset:0; background:#f8e8bf; border:4rpx solid currentColor; transform:translateZ(58rpx); }
.walk-model--taoxichuan .walk-roof { background:#c38463; }
.walk-front,.walk-back {
  width:100%; height:58rpx; left:0;
  background:repeating-linear-gradient(90deg,#ffffff32 0,#ffffff32 11rpx,transparent 11rpx,transparent 23rpx),currentColor;
}
.walk-front { bottom:100%; transform-origin:bottom; transform:rotateX(-90deg); }
.walk-back { top:100%; transform-origin:top; transform:rotateX(90deg); }
.walk-side,.walk-left { width:58rpx; height:100%; top:0; background:currentColor; box-shadow:inset 0 0 0 70rpx #18221b24; }
.walk-side { right:100%; transform-origin:right; transform:rotateY(90deg); }
.walk-left { left:100%; transform-origin:left; transform:rotateY(-90deg); }
.walk-grove { position:absolute; width:23%; height:7%; border-top:9rpx dotted #638268; }
.walk-grove-left { left:11%; bottom:14%; }
.walk-grove-right { right:10%; top:14%; }
.walk-stage button {
  position:absolute;
  z-index:1;
  padding:10rpx 18rpx;
  min-height:75rpx;
  background:#fffdf3;
  color:#254a38;
  border:1px solid #617967;
  border-radius:5rpx;
  font-size:24rpx;
  font-weight:700;
}
.walk-stage .walk-turn { top:12rpx; right:12rpx; min-height:64rpx; font-size:22rpx; }
.walk-marker { transition:top 360ms ease; white-space:nowrap; }
.walk-marker--museum { left:8%; top:58%; }
.walk-marker--taoxichuan { right:7%; top:44%; }
.walk-marker--museum.walk-marker-alt { top:44%; }
.walk-marker--taoxichuan.walk-marker-alt { top:58%; }
.walk-stage .walk-current { background:#254a38; color:#fffdf3; }
.walk-caption { margin:13rpx 0 23rpx; }
.walk-detail,.walk-list { padding-top:18rpx; border-top:1px solid #859789; }
.walk-photo { display:block; width:100%; height:225rpx; }
.walk-page .walk-credit { font-size:22rpx; }
.walk-list .field-heading { margin-bottom:10rpx; font-size:30rpx; }
@media (prefers-reduced-motion:reduce) {
  .walk-board,.walk-volume,.walk-marker { transition:none; }
}
