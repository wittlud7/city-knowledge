<view class="page" wx:if="{{record}}"><view wx:if="{{record.photo}}" bindtap="photo"><image class="scenario-image" src="{{record.photo.miniUrl}}" mode="aspectFill"/><view class="meta">{{record.photo.caption}} · {{record.photo.date}} · © {{record.photo.author}} · {{record.photo.license}}</view></view><view class="eyebrow">{{record.district}} · 城市资料</view><view class="h1">{{record.name||record.title}}</view><view class="body">{{record.summary||record.body}}</view><view wx:if="{{record.scope}}" class="scope-note">{{record.scope}}</view><view wx:if="{{record.publishedAt}}" class="meta">原文发布：{{record.publishedAt}}</view><view><text wx:for="{{record.tags}}" wx:key="*this" class="tag">{{item}}</text></view><block wx:if="{{type==='place'}}"><view class="panel"><view class="label">开放与预约</view><view class="body">{{record.opening}}</view><view class="label">无障碍设施</view><view class="body">{{record.accessibility}}</view><view class="label">停留建议</view><view class="body">{{record.duration}} 分钟，按个人体力调整</view><view class="label">费用</view><view class="body">{{record.price===null?'尚待核验':record.price+'元（参考）'}}</view></view><button class="primary" bindtap="navigate">在地图中查看近似位置</button></block><view wx:if="{{record.verificationScope}}" class="notice">核验范围：{{record.verificationScope}}</view><view wx:if="{{record.coordinateSource}}" class="meta">地理参考：{{record.coordinateSource.publisher}} · {{record.coordinateSource.license}}。{{record.coordinateNote}}</view><view wx:if="{{record.verifiedAt}}" class="meta">核验日期：{{record.verifiedAt}}，不代表实时状态。</view><view class="h2">原文依据</view><view wx:for="{{record.sources}}" wx:key="id" class="source" data-source="{{item}}" bindtap="source"><view class="title">{{item.title}} ↗</view><view class="meta">{{item.publisher}} · {{item.publishedAt||"原文日期未记录"}} · {{item.archived?"归档页需复核":"原文可追溯"}}</view><view class="meta">点击复制来源链接</view></view><button class="secondary" bindtap="favorite">{{saved?'已收藏 · 点击取消':'收藏这份资料'}}</button><view wx:if="{{record.related.length}}" class="h2">延伸了解</view><view wx:for="{{record.related}}" wx:key="id" class="article-row" data-id="{{item.id}}" bindtap="article"><view class="title">{{item.title}} ↗</view></view><view class="h2">发现信息有误？</view><textarea placeholder="说明问题及可核对的来源，请勿填写敏感个人信息" value="{{correction}}" bindinput="input" maxlength="2000"/><button class="secondary" bindtap="feedback">提交纠错</button></view><view wx:else class="empty">正在读取资料…</view>
