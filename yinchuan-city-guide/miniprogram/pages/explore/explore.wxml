<view class="page"><view class="eyebrow">EXPLORE YINCHUAN</view><view class="h1">每一处，都有故事</view><view class="sub">沿着地点、区域与兴趣，认识银川。</view><view class="search"><input placeholder="地点、街区、生活问题…" value="{{q}}" bindinput="input" bindconfirm="search"/><button bindtap="search">搜索</button></view><picker range="{{districtOptions}}" value="{{districtIndex}}" bindchange="district"><view class="field">区域：{{districtOptions[districtIndex]}} ▾</view></picker><scroll-view class="chips" scroll-x><view class="chip {{!category?'active':''}}" data-id="" bindtap="category">全部内容</view><view wx:for="{{boot.categories}}" wx:key="id" class="chip {{category===item.id?'active':''}}" data-id="{{item.id}}" bindtap="category">{{item.name}}</view></scroll-view><view class="row between"><view class="meta">{{places.length}} 个地点 · {{articles.length}} 篇资料</view><view class="tabs"><button class="{{view==='list'?'active':''}}" data-view="list" bindtap="view">列表</button><button class="{{view==='map'?'active':''}}" data-view="map" bindtap="view">地图</button><button class="{{view==='districts'?'active':''}}" data-view="districts" bindtap="view">区域比较</button></view></view><view wx:if="{{view==='districts'}}"><view wx:if="{{!profiles.length}}" class="notice">区县比较档案待核验，暂不生成区域排名。</view><view class="row"><picker range="{{boot.districts}}" value="{{compareA}}" data-field="compareA" bindchange="compare"><view class="field">{{boot.districts[compareA]}} ▾</view></picker><picker range="{{boot.districts}}" value="{{compareB}}" data-field="compareB" bindchange="compare"><view class="field">{{boot.districts[compareB]}} ▾</view></picker></view><view wx:for="{{comparison}}" wx:key="id" class="panel"><view class="h2">{{item.name}}</view><view class="label">位置认识</view><view class="body">{{item.position}}</view><view class="label">探索主题</view><view class="body">{{item.theme}}</view><view class="label">可以继续查询</view><view class="body">{{item.lookups}}</view><view class="notice">{{item.note}}</view><button class="link" data-source="{{item.source}}" bindtap="source">查看归档基础来源</button></view></view><view wx:elif="{{view==='map'}}"><map class="map" latitude="38.4872" longitude="106.2309" scale="10" markers="{{markers}}" bindmarkertap="marker"/><view class="notice">GCJ-02 近似点位，仅供定位，不代表具体入口。</view></view><block wx:else><view wx:for="{{places}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="place"><view class="row between"><view class="title">{{item.name}}</view><view class="meta">{{item.district}} ↗</view></view><view class="body">{{item.summary}}</view><view><text wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag" class="tag">{{tag}}</text></view><view class="meta">建议 {{item.duration}} 分钟 · 开放与预约待核实</view></view><view wx:if="{{!places.length}}" class="empty">还没有匹配地点，可试试其他关键词。</view></block><view class="h2">相关资料与指南</view><view wx:for="{{articles}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="article"><view class="title">{{item.title}} ↗</view><view class="body">{{item.body}}</view></view></view>
