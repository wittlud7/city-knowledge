<view class="page"><view class="eyebrow">WHAT’S ON</view><view class="h1">乌鲁木齐，正在发生什么</view><view class="sub">有日期、有来源、经审核的活动。过期自动退出当前列表。</view><picker mode="date" value="{{date}}" bindchange="date"><view class="field">{{date||'按日期筛选活动'}} ▾</view></picker><button wx:if="{{date}}" class="link" bindtap="clear">清除日期筛选</button><view wx:if="{{!events.length}}" class="empty">{{loaded?'当期活动仍在核验中，暂时没有符合条件的已核验活动。':'正在查询活动…'}}</view><view wx:for="{{events}}" wx:key="id" class="panel"><view class="meta">{{item.startDate}} — {{item.endDate}} · {{item.district}}</view><view class="h2">{{item.title}}</view><view class="body">{{item.body}}</view><view class="meta">场地：{{item.location}}</view><button class="link" data-source="{{item.source}}" bindtap="source">复制官方活动入口 ↗</button></view><view class="h2">先从官方渠道找一找</view><view wx:for="{{sources}}" wx:key="id" class="source" data-source="{{item}}" bindtap="source"><view class="title">{{item.title}} ↗</view><view class="meta">点击复制官方链接</view></view></view>
